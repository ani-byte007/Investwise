# GEMINI_API_KEY: Required for server-side Gemini AI research calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL LICENSED FINANCIAL DATA PROVIDER ADAPTER CREDENTIALS
# Leave unset until commercial licensing terms are verified and approved.
FINANCIAL_DATA_PROVIDER="nse_reference"
LICENSED_FEED_API_KEY=""
LICENSED_FEED_BASE_URL=""

# OPTIONAL PAYMENT GATEWAY WEBHOOK VERIFICATION (e.g., Razorpay)
# Required only when live payment gateway checkout is enabled.
PAYMENT_WEBHOOK_SECRET=""
